# 前端环境变量示例：复制为 .env.local 后按需修改（本文件仅为示例，不参与构建）
# 详细说明与后端接口约定见 docs/api-integration.md

# 运行模式：mock = 本地模拟服务（默认，演示用）；real = 调用应用后端
# 兼容旧变量 VITE_SERVICE_MODE=mock|service（service 等价 real，VITE_API_MODE 优先）
VITE_API_MODE=mock

# 单独接入真实整理服务，其余能力保持 VITE_API_MODE 的选择；留空时跟随全局模式
# VITE_ORGANIZATION_API_MODE=real

# 应用后端地址（仅 real 模式使用；留空 = 与前端同源部署）
# 例：VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=

# Vite 开发服务器的 /api/v1 代理目标（生产部署需配置同源反向代理）
VITE_DEV_API_TARGET=http://127.0.0.1:8000

# 单次 HTTP 请求超时（毫秒，默认 15000；长任务轮询有独立节奏，不受此值影响）
VITE_API_TIMEOUT_MS=15000

# 安全边界：Rodin / 模型生成等第三方密钥只能放在后端（后端 .env），
# 前端不配置、不存储任何服务密钥。
