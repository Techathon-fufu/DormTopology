# 前端环境变量示例：复制为 .env.local 后按需修改（本文件仅为示例，不参与构建）
# 详细说明与后端接口约定见 docs/api-integration.md

# 仅控制识别和模型生成：mock = 明确标注的模拟数据（默认）；real = 请求应用后端
# 整理、理线及遗留布局规划固定请求后端，无本地规则模式或网页切换入口
# 兼容旧变量 VITE_SERVICE_MODE=mock|service（service 等价 real，VITE_API_MODE 优先）
VITE_API_MODE=mock

# 真实理线要求已确认尺寸/位置/接口及实际线长
# 支撑与扎带/集线槽安装条件尚未接入；真实几何通过不表示已验证安装可行性
# 旧 VITE_ORGANIZATION_API_MODE / VITE_CABLE_API_MODE 和浏览器模式覆盖已不再生效

# 应用后端地址（整理与理线始终使用；留空 = 与前端同源部署）
# 例：VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=

# Vite 开发服务器的 /api/v1 代理目标（生产部署需配置同源反向代理）
VITE_DEV_API_TARGET=http://127.0.0.1:8000

# 单次 HTTP 请求超时（毫秒，默认 15000；长任务轮询有独立节奏，不受此值影响）
VITE_API_TIMEOUT_MS=15000

# 安全边界：Rodin / 模型生成等第三方密钥只能放在后端（后端 .env），
# 前端不配置、不存储任何服务密钥。
